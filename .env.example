APP_NAME="BuildFlow Construction CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=buildflow_crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Network & Reverse Proxy ---
# For staging/production behind Nginx, AWS ALB, Cloudflare, or Traefik:
# Set TRUSTED_PROXIES to comma-separated proxy IPs/CIDRs (e.g. 127.0.0.1,10.0.0.0/8)
TRUSTED_PROXIES=

# --- Session Security ---
# In production with HTTPS, enable secure cookies:
SESSION_SECURE_COOKIE=false

# --- Laravel Reverb (WebSockets & Real-time Events) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=

# --- Anti-Malware / ClamAV Scanner ---
# When SCANNER_FAIL_CLOSED=true (automatic in production), uploads are rejected if ClamAV daemon is unreachable.
SCANNER_ENABLED=true
SCANNER_FAIL_CLOSED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
CLAMAV_TIMEOUT=3

# --- Disaster Recovery & Durable Backups (AES-256-GCM AEAD) ---
# BACKUP_ENCRYPT: Required in production. Unencrypted backups are blocked in production.
# BACKUP_ENCRYPTION_KEY: Dedicated 256-bit key (64 hex characters or 32+ character passphrase). Cannot fall back to APP_KEY in production.
BACKUP_ENCRYPT=true
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_CIPHER=AES-256-GCM
BACKUP_STORAGE_PATH=
BACKUP_RPO_TARGET_MINUTES=60
BACKUP_RPO_GRACE_MINUTES=15
BACKUP_RPO_CRITICAL_MINUTES=75

# --- Secondary Backup Replication ---
BACKUP_REPLICATION_ENABLED=false
BACKUP_REPLICATION_DRIVER=local_secondary
BACKUP_SECONDARY_PATH=
BACKUP_SECONDARY_RETENTION=7

